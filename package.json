{
  "name": "devkit",
  "version": "0.1.0",
  "private": true,
  "description": "A Chrome extension for web developers: clear a page's cache and site data, inspect what it ships, rewrite requests, handy utilities, and AI analysis of the page with your own model.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "catalog": "llm-models catalog --npm callable --require openai,anthropic,google,mistral --out public/models.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/mistral": "^4.0.80",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.163",
    "llm-connect": "^2.8.0",
    "llm-models": "^1.14.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  }
}
